generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                  Int         @id @default(1)
  maxGuestsPerBooking Int         @default(15)
  capacityPerSlot     Int         @default(30)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Reservation {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  dateTime  DateTime
  guests    Int
  notes     String?
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateTime, status])
}
